# Compile with Watcom 10.6 or OpenWatcom

CC = wcc386
CFLAGS = -iAPP -iDEPS\DATA -iDEPS\ENV /4r /s /otexan
OBJDIR = BIN

# Object files in BIN
OBJS = $(OBJDIR)\main.obj $(OBJDIR)\app.obj $(OBJDIR)\data.obj $(OBJDIR)\vgaregs.obj $(OBJDIR)\video.obj $(OBJDIR)\env.obj

# Final executable
bmpio.exe: $(OBJS)
	wlink system dos4g name bmpio file { $(OBJS) }

# Compile rules for each .c -> .obj in BIN
$(OBJDIR)\main.obj: main.c
	if not exist $(OBJDIR) mkdir $(OBJDIR)
	$(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\app.obj: APP\APP.C
	if not exist $(OBJDIR) mkdir $(OBJDIR)
	$(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\data.obj: DEPS\DATA\DATA.C
	if not exist $(OBJDIR) mkdir $(OBJDIR)
	$(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\vgaregs.obj: APP\VGAREGS.C
	if not exist $(OBJDIR) mkdir $(OBJDIR)
	$(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\video.obj: APP\VIDEO.C
	if not exist $(OBJDIR) mkdir $(OBJDIR)
	$(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\env.obj: DEPS\ENV\ENV.C
	if not exist $(OBJDIR) mkdir $(OBJDIR)
	$(CC) $(CFLAGS) -fo=$@ $<

